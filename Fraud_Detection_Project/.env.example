# Persistent SQLite location for the local application.
FRAUD_DB_PATH=data/fraud_platform.db

# Comma-separated browser origins allowed to call the API.
FRAUD_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Override artifact locations only when deploying a custom artifact bundle.
FRAUD_MODELS_DIR=models
FRAUD_PROCESSED_DATA_DIR=data/processed
